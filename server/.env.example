# Example environment variables for the server
# Copy this file to `.env` and update values for local development.

# SQLAlchemy database URL. Example formats:
# - PostgreSQL: postgresql://user:password@localhost:5432/dbname
# - SQLite (file): sqlite:///./dev.db
# - SQLite (memory, tests): sqlite:///:memory:
DATABASE_URL=postgresql://user:password@localhost:5432/contract_db

# Secret key for signing tokens (change in production)
SECRET_KEY=change-me

# Optional: email sender address
EMAIL_FROM=admin@example.com